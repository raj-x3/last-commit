# Server-side only. Never prefix these with a client-exposed prefix and never commit a real .env.

# Required. Gemini API key used to call gemma-4-26b-a4b-it.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional. Raises the GitHub REST API rate limit for public repositories.
# Use a token with no scopes (public read only). Leave blank to call GitHub unauthenticated (60 requests/hour per IP).
GITHUB_TOKEN=

# Optional. Defaults to 3000.
PORT=3000

# Optional. Per-client investigations allowed per 10 minutes (0 disables the limit). Defaults to 30.
RATE_LIMIT_MAX=30

# Optional. Set to 1 only when running behind a trusted reverse proxy, so the first X-Forwarded-For entry identifies the client.
TRUST_PROXY=
